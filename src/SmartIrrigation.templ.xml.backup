              <ComObjectRef Id="%AID%_O-%TT%%CC%106_R-%TT%%CC%10601" RefId="%AID%_O-%TT%%CC%106" FunctionText="Zone %C% Wochenmenge vorherige" Text="Zone %C% Wochenmenge vorherige" Priority="Low" ObjectSize="2 Bytes" DatapointType="DPST-9-26" op:hashHint="%AID%_O-%TT%%CC%106_R-%TT%%CC%10601" />
              <ComObjectRef Id="%AID%_O-%TT%%CC%107_R-%TT%%CC%10701" RefId="%AID%_O-%TT%%CC%107" FunctionText="Zone %C% Letzte Bewaesserung Zeit" Text="Zone %C% Letzte Bewaesserung Zeit" Priority="Low" ObjectSize="8 Bytes" DatapointType="DPST-19-1" op:hashHint="%AID%_O-%TT%%CC%107_R-%TT%%CC%10701" />
              <ComObjectRef Id="%AID%_O-%TT%%CC%108_R-%TT%%CC%10801" RefId="%AID%_O-%TT%%CC%108" FunctionText="Zone %C% Letzte Bewaesserung Menge" Text="Zone %C% Letzte Bewaesserung Menge" Priority="Low" ObjectSize="2 Bytes" DatapointType="DPST-9-26" op:hashHint="%AID%_O-%TT%%CC%108_R-%TT%%CC%10801" />
              <ComObjectRef Id="%AID%_O-%TT%%CC%109_R-%TT%%CC%10901" RefId="%AID%_O-%TT%%CC%109" FunctionText="Zone %C% Naechste Bewaesserung Zeit" Text="Zone %C% Naechste Bewaesserung Zeit" Priority="Low" ObjectSize="8 Bytes" DatapointType="DPST-19-1" op:hashHint="%AID%_O-%TT%%CC%109_R-%TT%%CC%10901" />
              <ComObjectRef Id="%AID%_O-%TT%%CC%110_R-%TT%%CC%11001" RefId="%AID%_O-%TT%%CC%110" FunctionText="Zone %C% Naechste Bewaesserung Menge" Text="Zone %C% Naechste Bewaesserung Menge" Priority="Low" ObjectSize="2 Bytes" DatapointType="DPST-9-26" op:hashHint="%AID%_O-%TT%%CC%110_R-%TT%%CC%11001" />
              <ComObjectRef Id="%AID%_O-%TT%%CC%111_R-%TT%%CC%11101" RefId="%AID%_O-%TT%%CC%111" FunctionText="Zone %C% Fehler" Text="Zone %C% Fehler" Priority="Low" ObjectSize="1 Bit" DatapointType="DPST-1-5" op:hashHint="%AID%_O-%TT%%CC%111_R-%TT%%CC%11101" />
              <ComObjectRef Id="%AID%_O-%TT%%CC%112_R-%TT%%CC%11201" RefId="%AID%_O-%TT%%CC%112" FunctionText="Zone %C% Fehlercode" Text="Zone %C% Fehlercode" Priority="Low" ObjectSize="1 Byte" DatapointType="DPST-5-10" op:hashHint="%AID%_O-%TT%%CC%112_R-%TT%%CC%11201" />
