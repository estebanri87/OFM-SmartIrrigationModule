          </Static>
          <Dynamic>
            <Channel Id="%AID%_CH-%TT%%CC%" Name="SIR_Zone%C%" Number="%C%" Text="Zone %C%" Icon="waves">
              <ParameterBlock Id="%AID%_PB-%TT%%CC%001" Name="SIR_ZoneBase" Text="Zone %C%" Icon="waves" ShowInComObjectTree="true">
                <ParameterSeparator Id="%AID%_PS-%TT%%CC%001" Text="Basis-Konfiguration" UIHint="Headline" />
                <ParameterRefRef RefId="%AID%_UP-%TT%%CC%000_R-%TT%%CC%00001" HelpContext="SIR-Zone-Enabled" />
                <choose ParamRefId="%AID%_UP-%TT%%CC%000_R-%TT%%CC%00001">
                  <when test="1">
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101" HelpContext="SIR-Zone-Name" />
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201" HelpContext="SIR-Zone-Area" />
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%003_R-%TT%%CC%00301" HelpContext="SIR-Zone-Flow" />

                    <ParameterSeparator Id="%AID%_PS-%TT%%CC%002" Text="Pflanzentyp &amp; Faktoren" UIHint="Headline" />
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%004_R-%TT%%CC%00401" HelpContext="SIR-Zone-PlantType" />
                    <choose ParamRefId="%AID%_UP-%TT%%CC%004_R-%TT%%CC%00401">
                      <when test="10">
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%005_R-%TT%%CC%00501" HelpContext="SIR-Zone-ETFactor" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%006_R-%TT%%CC%00601" HelpContext="SIR-Zone-Interception" />
                      </when>
                      <when default="true">
                        <ParameterSeparator Id="%AID%_PS-%TT%%CC%003" Text="ET-Faktor und Interzeptionsfaktor werden automatisch gesetzt." UIHint="Information" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%005_R-%TT%%CC%00501" HelpContext="SIR-Zone-ETFactor" Access="Read" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%006_R-%TT%%CC%00601" HelpContext="SIR-Zone-Interception" Access="Read" />
                      </when>
                    </choose>

                    <ParameterSeparator Id="%AID%_PS-%TT%%CC%004" Text="Wassermenge &amp; Frequenz" UIHint="Headline" />
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%007_R-%TT%%CC%00701" HelpContext="SIR-Zone-MinWeek" />
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%008_R-%TT%%CC%00801" HelpContext="SIR-Zone-MaxWeek" />
                    <ParameterSeparator Id="%AID%_PS-%TT%%CC%005" Text="Max. Menge pro Woche muss groesser oder gleich Min. Menge pro Woche sein." UIHint="Information" />
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%009_R-%TT%%CC%00901" HelpContext="SIR-Zone-BaseTemp" />

                    <ParameterSeparator Id="%AID%_PS-%TT%%CC%006" Text="Zeitfenster" UIHint="Headline" />
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%013_R-%TT%%CC%01301" HelpContext="SIR-Zone-TW1Active" />
                    <choose ParamRefId="%AID%_UP-%TT%%CC%013_R-%TT%%CC%01301">
                      <when test="1">
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%014_R-%TT%%CC%01401" HelpContext="SIR-Zone-TW1Start" IndentLevel="1" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%015_R-%TT%%CC%01501" HelpContext="SIR-Zone-TW1End" IndentLevel="1" />
                        <ParameterSeparator Id="%AID%_PS-%TT%%CC%007" Text="Zeitfenster 1: Ende muss nach Start liegen." UIHint="Information" IndentLevel="1" />
                      </when>
                    </choose>
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%016_R-%TT%%CC%01601" HelpContext="SIR-Zone-TW2Active" />
                    <choose ParamRefId="%AID%_UP-%TT%%CC%016_R-%TT%%CC%01601">
                      <when test="1">
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%017_R-%TT%%CC%01701" HelpContext="SIR-Zone-TW2Start" IndentLevel="1" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%018_R-%TT%%CC%01801" HelpContext="SIR-Zone-TW2End" IndentLevel="1" />
                        <ParameterSeparator Id="%AID%_PS-%TT%%CC%008" Text="Zeitfenster 2: Ende muss nach Start liegen." UIHint="Information" IndentLevel="1" />
                      </when>
                    </choose>
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%019_R-%TT%%CC%01901" HelpContext="SIR-Zone-TimeType" />
                    <choose ParamRefId="%AID%_UP-%TT%%CC%019_R-%TT%%CC%01901">
                      <when test="0">
                        <ParameterSeparator Id="%AID%_PS-%TT%%CC%009" Text="Bewaesserung startet flexibel innerhalb des Zeitfensters (empfohlen)." UIHint="Information" />
                      </when>
                      <when test="1">
                        <ParameterSeparator Id="%AID%_PS-%TT%%CC%010" Text="Bewaesserung startet exakt zur Startzeit. Bei Konflikt wird Fehler ausgegeben." UIHint="Information" />
                      </when>
                    </choose>

                    <choose ParamRefId="%AID%_UP-%TT%00023_R-%TT%0002301">
                      <when test="1">
                        <ParameterSeparator Id="%AID%_PS-%TT%%CC%011" Text="Erweiterte Einstellungen" UIHint="Headline" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%010_R-%TT%%CC%01001" HelpContext="SIR-Zone-BaseTempHyst" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%011_R-%TT%%CC%01101" HelpContext="SIR-Zone-MaxCycles" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%012_R-%TT%%CC%01201" HelpContext="SIR-Zone-MinPerCycle" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%020_R-%TT%%CC%02001" HelpContext="SIR-Zone-AbsMax" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%021_R-%TT%%CC%02101" HelpContext="SIR-Zone-MaxRuntime" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%022_R-%TT%%CC%02201" HelpContext="SIR-Zone-SoilThreshold" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%023_R-%TT%%CC%02301" HelpContext="SIR-Zone-RainDelayFactor" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%024_R-%TT%%CC%02401" HelpContext="SIR-Zone-ManualRuntime" />
                      </when>
                    </choose>
                  </when>
                </choose>
              </ParameterBlock>
            </Channel>
          </Dynamic>
        </ApplicationProgram>
      </ApplicationPrograms>
    </Manufacturer>
  </ManufacturerData>
</KNX>

